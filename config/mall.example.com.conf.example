server {
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/snippets/tgshopp-security-headers.conf;
    include /etc/nginx/snippets/tgshopp-image-rewrites.conf;

    location ^~ /media/mall-test/ {
        limit_except GET { deny all; }
        resolver 127.0.0.53 valid=300s ipv6=off;
        set $image_origin mall-test.s3.amazonaws.com;
        proxy_pass https://$image_origin$rootss_image_path;
        proxy_ssl_server_name on;
        proxy_ssl_name $image_origin;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $image_origin;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header Referer "";
        proxy_set_header Accept-Encoding "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_cache rootss_images;
        proxy_cache_key "$image_origin$rootss_image_path";
        proxy_cache_valid 200 30d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_hide_header Set-Cookie;
        expires 7d;
        add_header X-Image-Cache $upstream_cache_status always;
        sub_filter off off;
    }

    location ^~ /media/imgtest1/ {
        limit_except GET { deny all; }
        resolver 127.0.0.53 valid=300s ipv6=off;
