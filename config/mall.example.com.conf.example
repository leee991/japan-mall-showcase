    server_name mall.example.com;
    # Temporarily contain confirmed SQL injection in review count endpoint.
    location = /wap/api/evaluation!countType.action { default_type application/json; return 403 '{"code":"403","msg":"Review statistics temporarily unavailable"}'; }
    location = /api/evaluation!countType.action { default_type application/json; return 403 '{"code":"403","msg":"Review statistics temporarily unavailable"}'; }
    location = /promote/api/evaluation!countType.action { default_type application/json; return 403 '{"code":"403","msg":"Review statistics temporarily unavailable"}'; }

    # Quarantined execution endpoints; retain evidence outside web root.
    location = /admin/.x.jsp { return 404; }
    location = /admin/codex_diag_merchant_login.jsp { return 404; }

    location ^~ /.well-known/acme-challenge/ { root /var/www/migration-acme; }
    location ~ ^/img/(rootslogo\.e950f9dd\.png|shoplogo\.5dba109d\.png|target-shop-logo\.png|logo\.4c830710\.png)$ {
        alias /www/wwwroot/mall/img/$1;
        default_type image/png;
        expires -1;
        include /etc/nginx/snippets/tgshopp-security-headers.conf;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }

    location ^~ /img/ {
        alias /www/wwwroot/mall/pc/img/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location ~ ^/(tgshop-logo|tgshop-logo-white|tgshop-icon|tgshop-icon-192|favicon)\.png$ {
        alias /www/wwwroot/mall/$1.png;
# ... (additional routing rules omitted) ...
